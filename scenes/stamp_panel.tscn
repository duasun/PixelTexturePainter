[gd_scene load_steps=4 format=3]
[ext_resource type="Script" path="res://ui/stamp_panel.gd" id="panel_script"]
[ext_resource type="Script" path="res://ui/stamp_crop_preview.gd" id="preview_script"]
[ext_resource type="PackedScene" path="res://scenes/number_field.tscn" id="number"]
[node name="StampPanel" type="VBoxContainer"]
script = ExtResource("panel_script")
theme_override_constants/separation = 9
[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "STAMP / SOURCE"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.95,0.65,0.36,1)
[node name="Description" type="Label" parent="."]
layout_mode = 2
text = "Left drag: select stamp area · Wheel: zoom · Middle drag: pan"
autowrap_mode = 3
theme_override_font_sizes/font_size = 11
[node name="Actions" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6
[node name="Load" type="Button" parent="Actions"]
layout_mode = 2
text = "Load image…"
size_flags_horizontal = 3
tooltip_text = "Load PNG, JPG or WebP up to 4096 × 4096"
[node name="Full" type="Button" parent="."]
layout_mode = 2
text = "Use full image"
tooltip_text = "Reset the crop to use the entire stamp image"
[node name="SourceName" type="Label" parent="."]
layout_mode = 2
text = "No stamp image loaded"
clip_text = true
theme_override_font_sizes/font_size = 11
[node name="Preview" type="Control" parent="."]
custom_minimum_size = Vector2(250,230)
layout_mode = 2
clip_contents = true
mouse_default_cursor_shape = 3
texture_filter = 1
tooltip_text = "Wheel to zoom around the cursor; middle drag to pan; left drag to crop"
script = ExtResource("preview_script")
[node name="CropLabel" type="Label" parent="."]
layout_mode = 2
