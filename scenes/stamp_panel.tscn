[gd_scene load_steps=4 format=3]
[ext_resource type="Script" path="res://ui/stamp_panel.gd" id="panel_script"]
[ext_resource type="Script" path="res://ui/stamp_crop_preview.gd" id="preview_script"]
[ext_resource type="PackedScene" path="res://scenes/number_field.tscn" id="number"]
[node name="StampPanel" type="VBoxContainer"]
script = ExtResource("panel_script")
theme_override_constants/separation = 9
[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "STAMP / SOURCE"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.95,0.65,0.36,1)
[node name="Description" type="Label" parent="."]
layout_mode = 2
text = "Left drag: select stamp area · Wheel: zoom · Middle drag: pan"
autowrap_mode = 3
theme_override_font_sizes/font_size = 11
[node name="Actions" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6
[node name="Load" type="Button" parent="Actions"]
layout_mode = 2
text = "Load image…"
size_flags_horizontal = 3
tooltip_text = "Load PNG, JPG or WebP up to 4096 × 4096"
[node name="Full" type="Button" parent="."]
layout_mode = 2
text = "Use full image"
tooltip_text = "Reset the crop to use the entire stamp image"
[node name="SourceName" type="Label" parent="."]
layout_mode = 2
text = "No stamp image loaded"
clip_text = true
theme_override_font_sizes/font_size = 11
[node name="Preview" type="Control" parent="."]
custom_minimum_size = Vector2(250,230)
layout_mode = 2
clip_contents = true
mouse_default_cursor_shape = 3
texture_filter = 1
tooltip_text = "Wheel to zoom around the cursor; middle drag to pan; left drag to crop"
script = ExtResource("preview_script")
[node name="CropSummary" type="Label" parent="."]
layout_mode = 2
text = "Load an image, then drag on its preview to choose the stamp area."
autowrap_mode = 3
theme_override_font_sizes/font_size = 11
[node name="RotationRow" type="HBoxContainer" parent="."]
layout_mode = 2
[node name="RotationLabel" type="Label" parent="RotationRow"]
layout_mode = 2
text = "Rotation"
[node name="Rotation" parent="RotationRow" instance=ExtResource("number")]
layout_mode = 2
size_flags_horizontal = 3
minimum = -180.0
maximum = 180.0
value = 0.0
suffix = "°"
tooltip_text = "Rotate the stamp; Alt+right-drag over the model to change this angle"
[node name="SelectedLabel" type="Label" parent="."]
layout_mode = 2
text = "STAMP RESULT"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.95,0.65,0.36,1)
[node name="SelectedPreview" type="TextureRect" parent="."]
custom_minimum_size = Vector2(240,128)
layout_mode = 2
expand_mode = 1
stretch_mode = 5
texture_filter = 1
