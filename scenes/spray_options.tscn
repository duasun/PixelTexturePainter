[gd_scene load_steps=4 format=3]
[ext_resource type="Script" path="res://ui/spray_options.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/number_field.tscn" id="num"]
[ext_resource type="Theme" path="res://assets/tool_settings_theme.tres" id="small_theme"]
[node name="SprayOptions" type="GridContainer"]
script = ExtResource("script")
theme = ExtResource("small_theme")
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 8
columns = 7
visible = false
[node name="Label" type="Label" parent="."]
layout_mode = 2
text = "SPRAY"
custom_minimum_size = Vector2(80, 0)
theme_override_colors/font_color = Color(0.95,0.65,0.36,1)
[node name="OpacityLabel" type="Label" parent="."]
layout_mode = 2
text = "Opacity"
[node name="Opacity" parent="." instance=ExtResource("num")]
layout_mode = 2
value = 100.0
minimum = 0.0
maximum = 100.0
suffix = "%"
tooltip_text = "Maximum opacity of one spray stroke, even when you keep holding the mouse"
[node name="FlowLabel" type="Label" parent="."]
layout_mode = 2
text = "Flow"
[node name="Flow" parent="." instance=ExtResource("num")]
layout_mode = 2
value = 10.0
minimum = 0.0
maximum = 100.0
step = 0.5
suffix = "%"
tooltip_text = "Paint strength per particle; low flow builds up gradually toward the opacity limit"
[node name="ParticlesLabel" type="Label" parent="."]
layout_mode = 2
text = "Density"
[node name="Particles" parent="." instance=ExtResource("num")]
layout_mode = 2
value = 12.0
minimum = 1.0
maximum = 256.0
suffix = " dots"
tooltip_text = "Particles per spray burst."
[node name="SpacingLabel" type="Label" parent="."]
layout_mode = 2
text = "Spacing"
[node name="Spacing" parent="." instance=ExtResource("num")]
layout_mode = 2
value = 4.0
minimum = 1.0
maximum = 128.0
suffix = " px"
tooltip_text = "Distance in texels between bursts along the stroke."
[node name="RateLabel" type="Label" parent="."]
layout_mode = 2
text = "Rate"
[node name="Rate" parent="." instance=ExtResource("num")]
layout_mode = 2
value = 20.0
minimum = 1.0
maximum = 60.0
suffix = " /s"
tooltip_text = "Bursts per second while the pointer is still."
[node name="DistanceLabel" type="Label" parent="."]
layout_mode = 2
text = "Distance"
[node name="Distance" parent="." instance=ExtResource("num")]
layout_mode = 2
value = 100.0
minimum = 25.0
maximum = 400.0
suffix = "%"
tooltip_text = "Relative nozzle distance: wider footprint and lower strength at greater distance. The actual pixel diameter appears in the cursor bar."
[node name="Hint" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 1
clip_text = true
text = "Preview: next burst"
theme_override_font_sizes/font_size = 11

